# Database (auto-constructed in Docker from POSTGRES_PASSWORD)
DATABASE_URL=postgresql://harmony:changeme@localhost:5432/harmony
POSTGRES_PASSWORD=changeme

# NextAuth
# REQUIRED: generate with `openssl rand -base64 32`
NEXTAUTH_SECRET=CHANGE-ME-run-openssl-rand-base64-32
# IMPORTANT: Set this to your actual server URL (not localhost) for login redirects to work
NEXTAUTH_URL=http://localhost:3000

# Account signup (default: OFF). Public signup is disabled unless the users
# table is empty (first-run bootstrap). Set to "true" to open signup, then
# turn it back off once your accounts exist.
# SIGNUP_ENABLED=false
# Optional: require this code to sign up when SIGNUP_ENABLED=true
# SIGNUP_INVITE_CODE=

# Demo seed (default: OFF). db:seed is DESTRUCTIVE and only runs when true.
# SEED_DEMO=false
# SEED_DEMO_PASSWORD=harmony123

# LLM Provider: openai | claude | openai_compatible
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o  # or claude-sonnet-4-5-20250929 for claude provider

# Book covers: OpenLibrary is always used and needs no key. Google Books is a
# fallback for titles OpenLibrary does not index — mostly children's and
# educational books — and does need one, because keyless requests share a
# daily quota that is permanently exhausted (they return 429).
# Get one free: Google Cloud console -> enable "Books API" -> create an API
# key. No billing required. Leave unset to use OpenLibrary alone.
# GOOGLE_BOOKS_API_KEY=

# Cron security secret for /api/cron/bump-lessons
# Required for the `cron` service to run scheduled lesson bumping.
CRON_SECRET=replace-with-a-long-random-secret

# Application timezone (IANA name). All server-side "what day is it" decisions
# — the nightly bump, which week the planner opens on — use this. Set it to
# your family's timezone so the server agrees with the browser.
APP_TIMEZONE=America/Chicago

# Scheduled jobs. Both hours are UTC, not local time.
#   8Z  = 3am CDT / 2am CST  (nightly backup)
#   23Z = 6pm CDT / 5pm CST  (lesson bump, after the school day)
# BACKUP_HOUR=8
# BACKUP_KEEP_DAYS=14
# BUMP_HOUR=23
# DIGEST_HOUR=12

# Daily digest webhook (optional). When set, the morning cron POSTs a
# "what's due today" JSON payload here. See README > Daily Digest.
# HA_WEBHOOK_URL=https://homeassistant.local/api/webhook/harmony-digest

# iCal feed token — REQUIRED to enable /api/calendar/ical.
# The feed exposes every child's schedule, so it now fails closed: with no
# token set the endpoint returns 403. Subscribe with ?token=<value>.
# CALENDAR_ICAL_TOKEN=random-secret-for-ical-feed

# Trello import (optional — enables importing boards as curricula)
# TRELLO_API_KEY=
# TRELLO_TOKEN=
